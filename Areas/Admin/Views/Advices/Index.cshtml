@model FeelShare.Web.Areas.Admin.ViewModels.AdvicesIndexVM
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Советы к эмоциям";

    // Список справа/слева + форма редактирования
    var list = Model.List;     // IEnumerable<MoodAdvice>
    var form = Model.Form;     // MoodAdvice
    var q = Model.Query ?? "";
}

@section Styles {
    <style>
        
        body.theme-dark .page-title,
        body.theme-dark h1, body.theme-dark h2, body.theme-dark h3, body.theme-dark .h1, body.theme-dark .h2, body.theme-dark .h3, body.theme-dark .h4 {
            color: #f8fafc;
        }

        body.theme-dark .card,
        body.theme-dark .block-card,
        body.theme-dark .panel,
        body.theme-dark .content-card {
            background: #020617;
            border-color: #1f2937;
            color: #e5e7eb;
        }

        body.theme-dark .form-control,
        body.theme-dark .form-select,
        body.theme-dark input[type="text"],
        body.theme-dark input[type="search"],
        body.theme-dark select {
            background: #0b1220 !important;
            border-color: #1f2937 !important;
            color: #e5e7eb !important;
        }

            body.theme-dark .form-control::placeholder {
                color: #94a3b8 !important;
            }

            body.theme-dark .form-control:focus,
            body.theme-dark .form-select:focus {
                border-color: rgba(59,130,246,.75) !important;
                box-shadow: 0 0 0 .2rem rgba(59,130,246,.15) !important;
            }

        body.theme-dark .btn-outline-secondary {
            border-color: #334155;
            color: #cbd5e1;
        }

            body.theme-dark .btn-outline-secondary:hover {
                background: #0b1220;
                border-color: #64748b;
                color: #f8fafc;
            }

        body.theme-dark table.table {
            color: #e5e7eb !important;
            border-color: #1f2937 !important;
        }

        body.theme-dark .table thead th {
            color: #cbd5e1 !important;
            background: #0b1220 !important;
            border-color: #1f2937 !important;
        }

        body.theme-dark .table tbody td {
            color: #e5e7eb !important;
            border-color: #1f2937 !important;
        }

        body.theme-dark .table tbody tr {
            background: rgba(2,6,23,.55) !important;
        }

            body.theme-dark .table tbody tr:hover {
                background: rgba(15,23,42,.7) !important;
            }

        body.theme-dark hr,
        body.theme-dark .border-top,
        body.theme-dark .border-bottom {
            border-color: #1f2937 !important;
        }

        body.theme-dark .btn-outline-danger {
            border-color: rgba(239,68,68,.55) !important;
            color: #fecaca !important;
        }

            body.theme-dark .btn-outline-danger:hover {
                background: rgba(239,68,68,.12) !important;
                border-color: rgba(239,68,68,.95) !important;
                color: #fff !important;
            }

        body.theme-dark .text-muted {
            color: #9ca3af !important;
        }
    </style>
}

<h2 class="h4 mb-3">@ViewData["Title"]</h2>

<!-- сюда JS будет вставлять уведомления -->
<div id="flashHost"></div>

<div class="row g-3">
    <div class="col-md-7">
        <!-- Поиск по списку -->
        <div class="d-flex gap-2 mb-2">
            <input id="searchBox" class="form-control" placeholder="Поиск по тексту/категории" value="@q" />
            <button id="clearBtn" class="btn btn-outline-secondary" type="button">Сброс</button>
        </div>

        <!-- сюда подгружается partial со списком -->
        <div id="listWrap">
            @await Html.PartialAsync("_AdviceList", list)
        </div>
    </div>

    <div class="col-md-5">
        <!-- сюда подгружается partial с формой -->
        <div id="formWrap" class="card">
            <div class="card-body">
                @await Html.PartialAsync("_AdviceForm", form)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            // ===== DOM =====
            const listWrap = document.getElementById('listWrap');
            const formWrap = document.getElementById('formWrap');
            const flashHost = document.getElementById('flashHost');
            const searchBox = document.getElementById('searchBox');
            const clearBtn = document.getElementById('clearBtn');

            // Показ уведомления на 5 секунд
            function showFlash(msg, ok = true) {
                const el = document.createElement('div');
                el.className = `alert ${ok ? 'alert-success' : 'alert-danger'} mb-3`;
                el.textContent = msg;
                flashHost.innerHTML = '';
                flashHost.appendChild(el);
                setTimeout(() => el.remove(), 5000);
            }

            // Anti-forgery токен берём из формы справа
            function antiForgery() {
                const f = formWrap.querySelector('form');
                return f ? (f.querySelector('input[name="__RequestVerificationToken"]')?.value || '') : '';
            }

            // Подгрузка списка partial с фильтром q
            async function loadList(q) {
                const url = `/Admin/Advices/List${q ? ('?q=' + encodeURIComponent(q)) : ''}`;
                const html = await (await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })).text();
                listWrap.innerHTML = html;
            }

            // Подгрузка формы partial для edit или для пустой формы
            async function loadForm(id) {
                const url = `/Admin/Advices/Edit${id ? ('?id=' + id) : ''}`;
                const html = await (await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })).text();
                formWrap.innerHTML = `<div class="card-body">${html}</div>`;
            }

           
            let t = null;
            searchBox.addEventListener('input', () => {
                clearTimeout(t);
                t = setTimeout(() => loadList(searchBox.value.trim()), 300);
            });

            clearBtn.addEventListener('click', () => {
                searchBox.value = '';
                loadList('');
                searchBox.focus();
            });

            //  делегирование кликов в списке 
            listWrap.addEventListener('click', async (e) => {
                const btnEdit = e.target.closest('.js-edit');
                const btnTgl = e.target.closest('.js-toggle');
                const btnDel = e.target.closest('.js-delete');

                // Редактирование подгружаю форму справа
                if (btnEdit) {
                    e.preventDefault();
                    await loadForm(btnEdit.dataset.id);
                    return;
                }

                // Вкл/выкл (Toggle)
                if (btnTgl) {
                    e.preventDefault();
                    const fd = new FormData();
                    fd.append('__RequestVerificationToken', antiForgery());
                    fd.append('id', btnTgl.dataset.id);

                    const r = await fetch('/Admin/Advices/Toggle', {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: fd,
                        credentials: 'same-origin'
                    });

                    const data = await r.json();
                    showFlash(data.message);
                    await loadList(searchBox.value.trim());
                    return;
                }

                // Удаление Delete
                if (btnDel) {
                    e.preventDefault();
                    if (!confirm('Удалить совет?')) return;

                    const fd = new FormData();
                    fd.append('__RequestVerificationToken', antiForgery());
                    fd.append('id', btnDel.dataset.id);

                    const r = await fetch('/Admin/Advices/Delete', {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: fd,
                        credentials: 'same-origin'
                    });

                    const data = await r.json();
                    showFlash(data.message);
                    await loadList(searchBox.value.trim());
                    return;
                }
            });

            //отправка формы справа Save
            document.addEventListener('submit', async (e) => {
                const form = e.target.closest('#formWrap form');
                if (!form) return;

                e.preventDefault();
                const btn = form.querySelector('[type="submit"]');
                btn.disabled = true;

                try {
                    const r = await fetch(form.action, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: new FormData(form),
                        credentials: 'same-origin'
                    });

                    const ctype = r.headers.get('content-type') || '';

                    if (ctype.includes('application/json')) {
                       
                        const data = await r.json();

                        if (data.ok) {
                            showFlash(data.message);
                            await loadList(searchBox.value.trim()); // обновляю список
                            await loadForm(null);                 
                        } else {
                            showFlash('Не удалось сохранить', false);
                        }
                    } else {
                        // Ошибка валидации: сервер вернул HTML формы с ошибками
                        formWrap.innerHTML = `<div class="card-body">${await r.text()}</div>`;
                    }
                } catch {
                    showFlash('Ошибка сети', false);
                } finally {
                    btn.disabled = false;
                }
            });

            // Кнопка "Новый" в форме
            formWrap.addEventListener('click', (e) => {
                const b = e.target.closest('.js-new');
                if (!b) return;
                e.preventDefault();
                loadForm(null);
            });
        })();
    </script>
}
