@model List<FeelShare.Web.Models.PublicStory>
@using FeelShare.Web.Models

@{
    // Беру параметры из ViewBag, которые контроллер положил в Index()
    var tab = (string)(ViewBag.Tab ?? "pending");
    var page = (int)(ViewBag.Page ?? 1);
    var total = (int)(ViewBag.Total ?? 0);
    var pageSize = (int)(ViewBag.PageSize ?? 20);

  
    var pages = (int)Math.Ceiling(total / (double)pageSize);
}

@section Styles {
    <style>
        /* Тут стили для тёмной темы конкретно для страницы модерации */
        body.theme-dark {
            --m-bg: #020617;
            --m-bg-soft: #0b1220;
            --m-border: #1f2937;
            --m-text: #e5e7eb;
            --m-muted: #9ca3af;
            --m-head: #f8fafc;
        }

            /* Заголовки */
            body.theme-dark h2,
            body.theme-dark .h4 {
                color: var(--m-head);
            }

            /* Карточки */
            body.theme-dark .card {
                background: var(--m-bg);
                border-color: var(--m-border);
                color: var(--m-text);
                box-shadow: 0 10px 26px rgba(0,0,0,.65);
            }

            body.theme-dark .card-body {
                background: transparent;
            }

            body.theme-dark .text-muted {
                color: var(--m-muted) !important;
            }

            /* Вкладки */
            body.theme-dark .btn-outline-primary {
                border-color: rgba(59,130,246,.55);
                color: #c7d2fe;
            }

                body.theme-dark .btn-outline-primary:hover {
                    background: rgba(59,130,246,.12);
                    border-color: rgba(59,130,246,.85);
                    color: #fff;
                }

                body.theme-dark .btn-outline-primary.active,
                body.theme-dark .btn-outline-primary:active {
                    background: rgba(59,130,246,.25);
                    border-color: rgba(59,130,246,.95);
                    color: #fff;
                }

            /* Сообщение "пусто" */
            body.theme-dark .alert-info {
                background: rgba(59,130,246,.10);
                border-color: rgba(59,130,246,.25);
                color: #dbeafe;
            }

            /* Кнопки действий */
            body.theme-dark .btn-success {
                background: #16a34a;
                border-color: #16a34a;
            }

            body.theme-dark .btn-danger {
                background: #ef4444;
                border-color: #ef4444;
            }

            body.theme-dark .btn-warning {
                background: #f59e0b;
                border-color: #f59e0b;
                color: #111827;
            }

           
            body.theme-dark .form-control {
                background: var(--m-bg-soft) !important;
                border-color: var(--m-border) !important;
                color: var(--m-text) !important;
            }

                body.theme-dark .form-control::placeholder {
                    color: var(--m-muted) !important;
                }

            /* Пагинация */
            body.theme-dark .pagination .page-link {
                background: var(--m-bg);
                border-color: var(--m-border);
                color: var(--m-text);
            }

                body.theme-dark .pagination .page-link:hover {
                    background: rgba(255,255,255,.06);
                    color: #fff;
                }

            body.theme-dark .pagination .page-item.active .page-link {
                background: rgba(59,130,246,.25);
                border-color: rgba(59,130,246,.9);
                color: #fff;
            }

            body.theme-dark .pagination .page-item.disabled .page-link {
                background: rgba(255,255,255,.03);
                color: rgba(229,231,235,.45);
            }
    </style>
}

<h2 class="h4 mb-3">Модерация</h2>

<!-- Переключатель вкладок: pending / reported -->
<div class="btn-group mb-3" role="group">
    <a class="btn btn-outline-primary @(tab=="pending"?"active":"")"
       asp-area="Admin" asp-controller="Moderation" asp-action="Index" asp-route-tab="pending">
        Очередь
    </a>

    <a class="btn btn-outline-primary @(tab=="reported"?"active":"")"
       asp-area="Admin" asp-controller="Moderation" asp-action="Index" asp-route-tab="reported">
        Жалобы
    </a>
</div>

@if (!Model.Any())
{
    <!-- Если историй нет просто показываю пустое состояние -->
    <div class="alert alert-info">Пока пусто.</div>
}
else
{
    <!-- Список карточек историй -->
    <div class="vstack gap-3">
        @foreach (var s in Model)
        {
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <!-- Служебная информация: id, эмоция, дата -->
                        <div class="small text-muted">
                            #@s.Id · @s.Emotion.Icon @s.Emotion.Name · @s.CreatedAtUtc.ToLocalTime().ToString("g")
                        </div>

                        <!-- Статус и жалобы -->
                        <div class="small">
                            Жалобы: <b>@s.ReportsCount</b> · Статус: <b>@s.ModerationStatus</b>
                        </div>
                    </div>

                    <!-- Контент истории -->
                    <div class="mt-2" style="white-space:pre-wrap">@s.Content</div>

                    <!-- Форма действий: все кнопки — POST  -->
                    <form method="post" class="mt-3 d-flex gap-2 flex-wrap">
                        @Html.AntiForgeryToken()

                        <!-- Передаю необходимые параметры обратно в контроллер -->
                        <input type="hidden" name="id" value="@s.Id" />
                        <input type="hidden" name="tab" value="@tab" />
                        <input type="hidden" name="page" value="@(page.ToString())" />

                        <!-- Одобрить -->
                        <button formaction="@Url.Action("Approve","Moderation", new { area="Admin" })"
                                class="btn btn-sm btn-success">
                            Одобрить
                        </button>

                        <!-- Отклонить -->
                        <button formaction="@Url.Action("Reject","Moderation", new { area="Admin" })"
                                class="btn btn-sm btn-danger">
                            Отклонить
                        </button>

                        <!-- Скрыть показываю только на вкладке reported -->
                        @if (tab == "reported")
                        {
                            <button formaction="@Url.Action("Hide","Moderation", new { area="Admin" })"
                                    class="btn btn-sm btn-warning">
                                Скрыть
                            </button>
                        }
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- Пагинация -->
    @if (pages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                @for (int p = 1; p <= pages; p++)
                {
                    <li class="page-item @(p==page?"active":"")">
                        <a class="page-link"
                           asp-area="Admin" asp-controller="Moderation" asp-action="Index"
                           asp-route-tab="@tab" asp-route-page="@p">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
